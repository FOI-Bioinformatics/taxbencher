nextflow_process {

    name "Test Process PREPARE_TAXDUMP"
    script "../main.nf"
    process "PREPARE_TAXDUMP"

    tag "modules"
    tag "modules_local"
    tag "prepare_taxdump"

    test("prepare taxdump - reduced taxdump") {

        when {
            process {
                """
                input[0] = file('${projectDir}/assets/test_data/taxonomy/taxdump.tar.gz', checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.taxdump.size() == 1 },
                { assert path("${process.out.taxdump.get(0)}/nodes.dmp").size() > 0 },
                { assert path("${process.out.taxdump.get(0)}/names.dmp").size() > 0 },
                { assert path("${process.out.taxdump.get(0)}/merged.dmp").exists() },
                { assert snapshot(
                    process.out.taxdump,
                    process.out.findAll { key, _value -> key.startsWith('versions') }
                ).match() }
            )
        }

    }

    test("prepare taxdump - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = file('${projectDir}/assets/test_data/taxonomy/taxdump.tar.gz', checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

    test("prepare taxdump - missing archive should fail") {

        when {
            process {
                """
                input[0] = file('${moduleDir}/tests/does_not_exist.tar.gz')
                """
            }
        }

        then {
            assert process.failed
        }

    }
}
