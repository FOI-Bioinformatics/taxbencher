/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running full-size tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a full size pipeline test.
    Uses the largest bundled dataset (three classifiers against a 43-taxon gold standard)
    and the pinned offline taxonomy.

    Use as follows:
        nextflow run FOI-Bioinformatics/taxbencher -profile test_full,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Full test profile'
    config_profile_description = 'Full test dataset to check pipeline function'

    input         = "${projectDir}/assets/test_data/samplesheet_realistic.csv"
    gold_standard = "${projectDir}/assets/test_data/gold_standard_realistic.bioboxes"
    taxdump       = "${projectDir}/assets/test_data/taxonomy/taxdump.tar.gz"
}
