nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"
    tag "pipeline"

    // The end-to-end pipeline test uses the realistic dataset because OPAL 1.0.13
    // crashes while rendering plots on very small inputs (<~30 taxa) - a documented
    // upstream limitation, not a pipeline bug. The minimal `test`/`test_raw` profiles
    // remain available for quickly exercising input handling and standardisation, and
    // the raw-profiler standardisation path is covered by the TAXPASTA_STANDARDISE
    // module test.

    test("-profile test_realistic - full pipeline with OPAL evaluation") {

        when {
            params {
                outdir = "$outputDir"
            }
            config "../conf/test_realistic.config"
        }

        then {
            def stable_name = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            def stable_path = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            assertAll(
                { assert workflow.success },
                // OPAL evaluation actually ran and produced metrics for this sample.
                { assert path("$outputDir/opal/test1/results.tsv").exists() },
                { assert snapshot(
                    // Number of successful tasks
                    workflow.trace.succeeded().size(),
                    // Software versions (Nextflow version stripped for portability)
                    removeNextflowVersion("$outputDir/pipeline_info/taxbencher_software_mqc_versions.yml"),
                    // All stable path names
                    stable_name,
                    // All files with stable contents
                    stable_path
                ).match() }
            )
        }
    }
}
